[Unit]
Description=HMI-Kiosk Netzwerk-Identität an das Gerät binden
# Bei jedem Start, nach /data und vor dem Netzwerk. Wurde die SD-Karte auf ein anderes Gerät
# übertragen, bekommt es hier eine eigene Maschinen-ID und einen eigenen Rechnernamen; sonst ändert sich
# nichts. RequiresMountsFor= ordnet nach dem Einhängen des Datenordners ein (im SD-Abbild /data, bei
# install.sh sorgt ein Drop-in für Datenordner und Pfad der Kennung). Das Skript endet immer mit 0 und nichts hängt von dieser Unit ab.
DefaultDependencies=no
Conflicts=shutdown.target
RequiresMountsFor=/data
Before=network-pre.target NetworkManager.service systemd-networkd.service shutdown.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/hmi-kiosk-identity
TimeoutStartSec=30s

[Install]
WantedBy=multi-user.target
