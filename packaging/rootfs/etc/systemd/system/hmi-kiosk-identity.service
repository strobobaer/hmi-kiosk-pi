[Unit]
Description=HMI-Kiosk Netzwerk-Identität an das Gerät binden
# Bei jedem Start, nach /data und vor dem Netzwerk. Wurde die SD-Karte auf ein anderes Gerät
# übertragen, bekommt es hier eine eigene Maschinen-ID und einen eigenen Rechnernamen; sonst
XX RequiresMountsFor= ordnet nach
# data.mount ein. Das Skript endet immer mit 0 und nichts hängt von dieser Unit ab.
DefaultDependencies=no
Conflicts=shutdown.target
RequiresMountsFor=/data
Before=network-pre.target NetworkManager.service systemd-networkd.service shutdown.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/hmi-kiosk-identity
TimeoutStartSec=30s

[Install]
WantedBy=multi-user.target
