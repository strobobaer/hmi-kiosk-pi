[Unit]
Description=HMI-Kiosk Datenpartition anlegen und einhängen (erster Start)
# Das Abbild hat keinen fstab-Eintrag für /data; dieser Dienst legt Partition und Eintrag an
# und hängt /data ein, bevor local-fs.target erreicht ist. Danach endet er bei jedem Start sofort.
DefaultDependencies=no
Wants=systemd-udevd.service
After=systemd-udevd.service systemd-remount-fs.service boot-firmware.mount
Before=local-fs.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/hmi-kiosk-firstboot prepare-data
TimeoutStartSec=15min

[Install]
WantedBy=local-fs.target
