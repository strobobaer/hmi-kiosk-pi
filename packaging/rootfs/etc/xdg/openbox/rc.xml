<?xml version="1.0" encoding="UTF-8"?>
<!-- openbox im Ausweichprofil x11 (Spec Abschnitt 2 und 6). -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <keepBorder>no</keepBorder>
  </theme>
  <!-- Die oberen 48 Pixel gehören der Sitzungsleiste; maximierte Fenster bleiben darunter. -->
  <margins>
    <top>48</top>
    <bottom>0</bottom>
    <left>0</left>
    <right>0</right>
  </margins>
  <applications>
    <!-- Remmina-Sitzung: ohne Rahmen bei 0,48 in Breite x (Höhe - 48), über den Rand oben und
         Maximieren unabhängig von der Auflösung. Regeln greifen beim ersten Anzeigen, da steht
         der Titel (client.RemminaTitlePrefix) noch nicht fest; daher WM_CLASS org.remmina.Remmina. -->
    <application class="org.remmina.Remmina" type="normal">
      <decor>no</decor>
      <position force="yes">
        <x>0</x>
        <y>48</y>
      </position>
      <maximized>yes</maximized>
    </application>
    <!-- Sitzungsleiste (Chromium mit -app=.../bar). -->
    <application name="127.0.0.1__bar">
      <decor>no</decor>
      <position force="yes">
        <x>0</x>
        <y>0</y>
      </position>
    </application>
  </applications>
  <!-- Keine Tastenkürzel und kein Menü. -->
  <keyboard />
  <mouse>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>
  </mouse>
</openbox_config>
