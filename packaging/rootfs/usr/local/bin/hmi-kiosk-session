#!/bin/sh
# Grafiksitzung des Kiosk-Benutzers, gestartet von hmi-kiosk-session.service.
#   hmi-kiosk-session prepare     liest GraphicsProfile und schreibt die Umgebungsdatei
#   hmi-kiosk-session             startet labwc (Standard) oder X11 mit openbox
#   hmi-kiosk-session x11-client  Sitzungsprogramm unter X11 (von startx aufgerufen)
set -eu

CONFIG=${HMI_KIOSK_CONFIG:-/data/config.json}
STATE_DIR=${HMI_KIOSK_SESSION_DIR:-/run/hmi-kiosk-session}
RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/1100}

# graphics_profile gibt labwc oder x11 aus. Gelesen wird config.json, sonst der letzte gute
# Stand; ohne lesbaren Wert gilt labwc wie in der Voreinstellung des Dienstes.
graphics_profile() {
	for f in "$CONFIG" "$CONFIG.good"; do
		[ -r "$f" ] || continue
		p=$(tr -d '\n' <"$f" | grep -o '"graphicsProfile"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n 1 | sed 's/.*"\([^"]*\)"$/\1/') || p=""
		case "$p" in
		labwc | x11)
			echo "$p"
			return
			;;
		"") ;;
		*) echo "Unbekanntes Grafikprofil $p in $f, verwende labwc" >&2 ;;
		esac
	done
	echo labwc
}

# input_mode gibt die eingestellte Bedienart aus (Kiosk → Bedienung): touch, mouse oder auto;
# ohne Angabe gilt touch (Dateien vor „auto“ bleiben so).
input_mode() {
	for f in "$CONFIG" "$CONFIG.good"; do
		[ -r "$f" ] || continue
		m=$(tr -d '\n' <"$f" | grep -o '"inputMode"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n 1 | sed 's/.*"\([^"]*\)"$/\1/') || m=""
		case "$m" in
		touch | mouse | auto)
			echo "$m"
			return
			;;
		"") ;;
		*) echo "Unbekannte Bedienart $m in $f, verwende touch" >&2 ;;
		esac
	done
	echo touch
}

# mouse_present ist erfolgreich, wenn ein Eingabegerät eine Maus oder ein Touchpad ist, aber kein Touchscreen
# (udev: ID_INPUT_MOUSE oder ID_INPUT_TOUCHPAD, nicht ID_INPUT_TOUCHSCREEN). Läuft ohne root; schlägt die
# Abfrage fehl, gilt: keine Maus. HMI_KIOSK_INPUT_DIR ersetzt /dev/input für Tests.
mouse_present() {
	command -v udevadm >/dev/null 2>&1 || return 1
	# Eine eben angesteckte Maus soll schon erkannt sein; scheitert das Warten, geht es trotzdem weiter.
	udevadm settle --timeout=3 >/dev/null 2>&1 || true
	for dev in "${HMI_KIOSK_INPUT_DIR:-/dev/input}"/event*; do
		[ -e "$dev" ] || continue
		props=$(udevadm info --query=property --name="$dev" 2>/dev/null) || continue
		# Ein Touchscreen mit Mauszeiger-Emulation zählt nicht als Maus.
		if printf '%s\n' "$props" | grep -qx 'ID_INPUT_TOUCHSCREEN=1'; then continue; fi
		if printf '%s\n' "$props" | grep -qx -e 'ID_INPUT_MOUSE=1' -e 'ID_INPUT_TOUCHPAD=1'; then return 0; fi
	done
	return 1
}

# effective_input gibt touch oder mouse aus: bei auto je nach erkannter Maus, sonst die Einstellung.
effective_input() {
	case "$1" in
	auto)
		if mouse_present; then echo mouse; else echo touch; fi
		;;
	*) echo "$1" ;;
	esac
}

prepare() {
	profile=$(graphics_profile)
	mkdir -p "$STATE_DIR"
	tmp="$STATE_DIR/.env.$$"
	case "$profile" in
	# DISPLAY=:0 unter labwc ist Xwayland, nötig für TigerVNC (nur X11).
	labwc) printf 'WAYLAND_DISPLAY=wayland-0\nDISPLAY=:0\n' >"$tmp" ;;
	x11) printf 'DISPLAY=:0\nXAUTHORITY=%s/Xauthority\n' "$STATE_DIR" >"$tmp" ;;
	esac
	chmod 0644 "$tmp"
	mv -f "$tmp" "$STATE_DIR/env"
	printf '%s\n' "$profile" >"$STATE_DIR/.profile.$$"
	mv -f "$STATE_DIR/.profile.$$" "$STATE_DIR/profile"
	setting=$(input_mode)
	input=$(effective_input "$setting")
	# Das Programm liest beide Dateien (input = wirksame Bedienart, input-setting = Einstellung beim Start);
	# der Ordner gehört dem Kiosk-Benutzer, lesbar für alle.
	printf '%s\n' "$setting" >"$STATE_DIR/.input-setting.$$"
	chmod 0644 "$STATE_DIR/.input-setting.$$"
	mv -f "$STATE_DIR/.input-setting.$$" "$STATE_DIR/input-setting"
	printf '%s\n' "$input" >"$STATE_DIR/.input.$$"
	chmod 0644 "$STATE_DIR/.input.$$"
	mv -f "$STATE_DIR/.input.$$" "$STATE_DIR/input"
	echo "Grafikprofil: $profile, Bedienung: $setting ($input)"
}

run_session() {
	profile=$(cat "$STATE_DIR/profile" 2>/dev/null || graphics_profile)
	input=$(cat "$STATE_DIR/input" 2>/dev/null || effective_input "$(input_mode)")
	export XDG_RUNTIME_DIR="$RUNTIME_DIR"
	nocursor=""
	if [ "$input" = touch ]; then
		# Unsichtbares Zeigerthema (labwc) und -nocursor (X11): bei Touch kein Mauszeiger.
		export XCURSOR_THEME=hmi-blank
		nocursor=-nocursor
	fi
	case "$profile" in
	labwc)
		export XDG_SESSION_TYPE=wayland
		# -C: nur die Konfiguration des Abbilds, nie eine aus dem Benutzerordner.
		exec labwc -C /etc/hmi-kiosk/labwc
		;;
	x11)
		export XDG_SESSION_TYPE=x11
		export XAUTHORITY="$STATE_DIR/Xauthority"
		# shellcheck disable=SC2086 # leeres $nocursor entfällt
		exec startx "$0" x11-client -- :0 vt1 -keeptty -nolisten tcp $nocursor -s 0 -dpms
		;;
	esac
}

x11_client() {
	# Unter X11 gibt es keine Bildschirmtastatur (wvkbd braucht Wayland-layer-shell);
	# der Dienst startet sie nur unter labwc, der Knopf „Tastatur“ bleibt ohne Wirkung.
	# Bildschirmschoner und Energiesparen aus; -nocursor beim Start blendet bei Touch den Zeiger aus.
	xset s off s noblank -dpms || echo "xset fehlgeschlagen" >&2
	exec openbox --config-file /etc/xdg/openbox/rc.xml
}

case "${1:-}" in
prepare) prepare ;;
x11-client) x11_client ;;
"") run_session ;;
*)
	echo "Aufruf: hmi-kiosk-session [prepare|x11-client]" >&2
	exit 2
	;;
esac
